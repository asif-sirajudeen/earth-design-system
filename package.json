{
  "name": "earth-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Earth Design System monorepo: the eds-ui package and its docs app",
  "license": "MIT",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "build:site": "node scripts/site-build.mjs",
    "registry:build": "pnpm --filter @asif-sirajudeen/eds-ui registry:build",
    "registry:snapshot": "pnpm --filter @asif-sirajudeen/eds-ui registry:snapshot",
    "changeset": "changeset",
    "version": "changeset version && pnpm registry:snapshot",
    "release": "pnpm --filter @asif-sirajudeen/eds-ui build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "typescript": "^6.0.3"
  }
}
