{
  "name": "@asif-sirajudeen/eds-ui",
  "version": "0.1.1",
  "description": "Earth Design System UI: shadcn base-nova components on Base UI, compiled by your Tailwind v4.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asif-sirajudeen/earth-design-system.git",
    "directory": "packages/eds-ui"
  },
  "homepage": "https://eds-ui.vercel.app",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./themes/default.css": "./dist/themes/default.css"
  },
  "bin": {
    "eds-ui": "./bin/eds-ui.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "check:stylesheet": "node scripts/check-stylesheet.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "lint": "eslint .",
    "registry:build": "shadcn build registry.json -o ../../apps/docs/public/r",
    "registry:validate": "shadcn registry validate registry.json",
    "registry:snapshot": "node scripts/registry-snapshot.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/cli": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
